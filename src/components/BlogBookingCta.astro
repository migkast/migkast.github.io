---
const { closingId = 'blog-closing-cta' } = Astro.props as { closingId?: string };
---
<aside class="blog-persistent-cta" data-blog-persistent data-closing-id={closingId} aria-label="Grow your company">
  <div>
    <span>Your next growth stage</span>
    <strong>Turn the real constraint into profitable growth.</strong>
  </div>
  <a class="button button-small" href="/contact/">Let&rsquo;s grow your company</a>
</aside>
<script>
  const persistentCtas = document.querySelectorAll<HTMLElement>('[data-blog-persistent]');

  persistentCtas.forEach((cta) => {
    const header = document.querySelector('.site-header');
    const closing = document.getElementById(cta.dataset.closingId || 'blog-closing-cta');
    const action = cta.querySelector<HTMLAnchorElement>('a');
    const mobileViewport = window.matchMedia('(max-width: 980px)');
    let headerAway = false;
    let closingVisible = false;

    const updateVisibility = () => {
      const visible = !closingVisible && (mobileViewport.matches || headerAway);
      cta.inert = !visible;
      cta.setAttribute('aria-hidden', String(!visible));
      if (visible) action?.removeAttribute('tabindex');
      else action?.setAttribute('tabindex', '-1');
    };

    updateVisibility();
    mobileViewport.addEventListener('change', updateVisibility);

    if (header) {
      const headerObserver = new IntersectionObserver(([entry]) => {
        headerAway = !entry.isIntersecting;
        cta.dataset.headerAway = String(headerAway);
        updateVisibility();
      });
      headerObserver.observe(header);
    }

    if (closing) {
      const closingObserver = new IntersectionObserver(([entry]) => {
        closingVisible = entry.isIntersecting;
        cta.dataset.closingVisible = String(closingVisible);
        updateVisibility();
      }, { threshold: 0.15 });
      closingObserver.observe(closing);
    }
  });
</script>
