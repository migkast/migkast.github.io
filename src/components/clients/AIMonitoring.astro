---
import VisibilityChart from './VisibilityChart.astro';
import { rankPosition, rankMovement } from '../../lib/clients/wheeler-rank-movement';
import { formatRecordedAnswer } from '../../lib/clients/wheeler-answer-format';
import { engines, visibility, categories, percentage, competitorCounts, identifiedCount } from '../../lib/clients/wheeler-visibility';
const latest=visibility.runs[visibility.runs.length-1];
const first=visibility.runs[0];
const latestIndex=visibility.runs.length-1;
const dates=visibility.runs.map(run=>new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Lisbon',day:'numeric',month:'short'}).format(new Date(run.startedAt)));
const modelSeries=engines.map(engine=>({key:engine.id,label:engine.label,icon:engine.icon,color:engine.color,counts:visibility.runs.map(run=>run.providers[engine.id].present),total:latest.promptCount}));
const competitors=visibility.runs.map(competitorCounts);
const topNames=Object.entries(competitors[latestIndex]).sort((a,b)=>b[1]-a[1] || a[0].localeCompare(b[0])).slice(0,4).map(([name])=>name);
const colors=['#2563eb','#d15a08','#8b3fc6','#be185d'];
const competitorSeries=[{key:'wheeler',label:'Wheeler Residential Steel Supply',color:'#087f5b',own:true,counts:visibility.runs.map(identifiedCount),total:latest.answerCount},...topNames.map((name,index)=>({key:`competitor-${index}`,label:name,color:colors[index],counts:competitors.map(counts=>counts[name]||0),total:latest.answerCount}))].sort((a,b)=>b.counts[latestIndex]-a.counts[latestIndex]);
const latestPresent=identifiedCount(latest);
const status=(result:{appears:boolean;identity:{verdict:string}})=>result.appears?'present':'absent';
const labels={present:'Mentioned',absent:'Not mentioned'};
const overallSeries=[{key:'overall',label:'Wheeler overall',color:'#16756c',counts:visibility.runs.map(identifiedCount),total:latest.answerCount}];
const ranking=[{name:'Wheeler Residential Steel Supply',own:true,counts:engines.map(e=>latest.providers[e.id].present)},...Object.keys(competitors[latestIndex]).map(name=>({name,own:false,counts:engines.map(e=>latest.competitors[e.id][name as keyof typeof latest.competitors[typeof e.id]]||0)}))].sort((a,b)=>b.counts.reduce((x,y)=>x+y,0)-a.counts.reduce((x,y)=>x+y,0));
const previous=visibility.runs[latestIndex-1];
const previousRanking=[{name:'Wheeler Residential Steel Supply',counts:engines.map(e=>previous.providers[e.id].present)},...Object.keys(competitors[latestIndex-1]).map(name=>({name,counts:engines.map(e=>previous.competitors[e.id][name as keyof typeof previous.competitors[typeof e.id]]||0)}))];
const scoreFor=(counts:number[],index:number)=>index<0?counts.reduce((a,b)=>a+b,0):counts[index];
const previousRanks=(name:string)=>[-1,0,1,2,3].map(index=>{const brand=previousRanking.find(item=>item.name===name);return rankPosition(brand?scoreFor(brand.counts,index):0,previousRanking.map(item=>scoreFor(item.counts,index)));});
const initialMovement=(name:string,counts:number[])=>rankMovement(rankPosition(scoreFor(counts,-1),ranking.map(item=>scoreFor(item.counts,-1))),previousRanks(name)[0]);
const groupedPrompts=Object.keys(categories).flatMap(category=>visibility.latestPrompts.map((prompt,index)=>({prompt,index})).filter(item=>item.prompt.category===category));

---
<div class="ai-monitoring">
 <header class="workspace-heading ai-monitoring-heading"><div><p class="eyebrow">SEARCH &amp; AI VISIBILITY</p><h1>AI Monitoring Agent</h1></div><div class="ai-test-date"><strong>Latest test · {dates[latestIndex]} 2026</strong><span>{latest.promptCount} prompts · 4 engines</span></div></header>
 <p class="ai-monitoring-intro">Tests the questions buyers ask AI engines, checks whether they identify the correct Wheeler, and tracks which other providers and sources appear.</p>
 <div class="ai-view-tabs" role="tablist" aria-label="AI monitoring views">{['Overview','Prompt testing','Competitors'].map((label,index)=><button type="button" id={`ai-tab-${index}`} role="tab" aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} aria-controls={`ai-view-${index}`} data-ai-tab={index}>{label}</button>)}</div>
 <section id="ai-view-0" role="tabpanel" aria-labelledby="ai-tab-0" data-ai-view="0">
 <section class="ai-latest-summary" aria-label="Latest test overview"><div><strong>{latestPresent}<span> / {latest.answerCount}</span></strong><p>answers mention Wheeler</p></div><div><strong>{percentage(latestPresent,latest.answerCount)}%</strong><p>visibility in this test</p></div><div><strong>{engines.length}</strong><p>AI engines tested</p></div><p class="ai-summary-definition">Mention counts refer to Wheeler Residential Steel Supply, using the reviewed results.</p></section>
 <div class="ai-engine-cards">{engines.map(engine=><section><div class="ai-engine-heading"><img class="ai-engine-logo" src={engine.icon} alt="" width="24" height="24" /><h2>{engine.label}</h2></div><strong>{percentage(latest.providers[engine.id].present,latest.promptCount)}%</strong><p>{latest.providers[engine.id].present} of {latest.promptCount} answers mention Wheeler</p><small>{percentage(latest.providers[engine.id].present,latest.promptCount)-percentage(first.providers[engine.id].present,first.promptCount)} percentage points since {dates[0]}</small></section>)}</div>
 <div class="ai-trend-heading"><h2>Visibility over time</h2><span>{dates[0]} → {dates[latestIndex]} 2026</span></div>

 <div class="ai-trend-controls" role="group" aria-label="Trend view"><button type="button" data-ai-trend="overall" aria-pressed="true">Overall</button><button type="button" data-ai-trend="model" aria-pressed="false">By engine</button><span>{percentage(latestPresent,latest.answerCount)-percentage(identifiedCount(first),first.answerCount)} percentage points since {dates[0]}</span></div>
 <div data-ai-trend-panel="model" hidden><VisibilityChart id="ai-engine-trend" title="Wheeler visibility by engine" description="Share of tested answers that mention Wheeler, across the saved tests." dates={dates} series={modelSeries} /></div>
 <div data-ai-trend-panel="overall"><VisibilityChart id="ai-overall-trend" title="Overall Wheeler visibility" description="Wheeler mentions across all four engines." dates={dates} series={overallSeries} /></div>
 <details class="ai-methodology"><summary>How these results are measured</summary><p>Visibility is the percentage of answers mentioning Wheeler Residential Steel Supply. Competing names are counted once per answer, as recorded.</p><p>The October 12 and October 19 tests use the same 22 questions. The September 23 question set differs. Each point reflects the saved answers and identity review for that test.</p></details>
 </section>
 <section id="ai-view-1" role="tabpanel" aria-labelledby="ai-tab-1" data-ai-view="1" hidden>
 <section class="ai-prompt-section" aria-labelledby="ai-prompts-heading"><div class="ai-prompts-heading"><div><h2 id="ai-prompts-heading">Latest prompts &amp; results</h2></div><span id="ai-prompt-count" role="status">{latest.promptCount} prompts</span></div>
 <div class="ai-prompt-filters"><div><label for="ai-prompt-search">Find a prompt</label><input type="search" id="ai-prompt-search" placeholder="Search the tested questions" /></div><div><label for="ai-prompt-category">Question category</label><select id="ai-prompt-category"><option value="all">All categories</option>{Object.entries(categories).map(([key,name])=><option value={key}>{name}</option>)}</select></div></div>
 <div class="ai-result-key"><span data-state="present">✓ Mentioned</span><span data-state="absent">− Not mentioned</span></div>
 <div class="ai-prompt-table-wrap"><table class="ai-prompt-table"><thead><tr><th scope="col">Prompt</th><th scope="col">Visibility</th><th scope="col">Models</th><th scope="col">Citation</th><th scope="col">Last tested</th><th scope="col">Actions</th></tr></thead><tbody>{groupedPrompts.map(({prompt,index},groupIndex)=>{
 const score=percentage(engines.filter(engine=>prompt.results[engine.id].appears).length,engines.length);
 const cited=engines.some(engine=>prompt.results[engine.id].citations.some(citation=>/^https?:\/\/(www\.)?getwheelersteel\.com(\/|$)/i.test(citation.url)));
 const firstEngine=engines.find(engine=>prompt.results[engine.id].appears)||engines[0];
 return <>{(groupIndex===0||groupedPrompts[groupIndex-1].prompt.category!==prompt.category)&&<tr class="ai-category-group" data-ai-group={prompt.category}><th colspan="6">{categories[prompt.category]} <span>· {groupedPrompts.filter(item=>item.prompt.category===prompt.category).length} prompts</span></th></tr>}
 <tr data-ai-prompt={index} data-ai-category={prompt.category}>
 <th scope="row"><p>{prompt.prompt}</p></th>
 <td class="ai-prompt-score"><span class="ai-score-ring" style={`--score:${score}%`} data-positive={score>0}><strong>{score}%</strong></span></td>
 <td class="ai-prompt-models"><div>{engines.map(engine=><button type="button" class="ai-model-result" data-ai-open={index} data-ai-engine={engine.id} data-state={status(prompt.results[engine.id])} aria-expanded="false" aria-controls={`ai-answer-${index}`} aria-label={`${engine.label}: ${labels[status(prompt.results[engine.id])]} for prompt ${index+1}`} title={`${engine.label}: ${labels[status(prompt.results[engine.id])]}. View answer`}><img src={engine.icon} alt="" width="22" height="22" /></button>)}</div></td>
 <td class="ai-prompt-citation" title={cited?'Wheeler website appears in saved source links':'No Wheeler website citation in saved source links'}>{cited?'✓ Cited':'−'}</td>
 <td class="ai-prompt-date"><span>Last tested</span><time datetime={prompt.recordedAt}>{dates[latestIndex]}</time></td>
 <td class="ai-prompt-action"><button type="button" data-ai-open={index} data-ai-engine={firstEngine.id} aria-expanded="false" aria-controls={`ai-answer-${index}`}>See answer</button></td></tr><tr class="ai-answer-row" data-ai-answer-row={index} hidden><td colspan="6"><section class="ai-answer-panel" id={`ai-answer-${index}`} aria-label={`Saved answer for prompt ${index+1}`}><header><div><h3 data-ai-answer-title></h3><p data-ai-answer-meta></p></div><button type="button" data-ai-close={index}>Close answer</button></header><div class="ai-identity-note"><strong data-ai-identity-label></strong><p data-ai-identity-reason></p></div><h4>Full recorded answer</h4><div class="ai-answer-body" data-ai-answer-text></div><section class="ai-answer-sources"><h4>Cited sources</h4><ul data-ai-answer-sources></ul><p data-ai-no-sources hidden>No structured source links were saved for this answer.</p></section></section></td></tr></>;})}</tbody></table></div>
 <p class="ai-empty-results" id="ai-empty-results" hidden>No prompts match these filters.</p>
 </section>
 </section>
 <section id="ai-view-2" role="tabpanel" aria-labelledby="ai-tab-2" data-ai-view="2" hidden>
 <VisibilityChart id="ai-competitor-trend" title="Top competitors by visibility" description="Wheeler alongside the four most-mentioned competing names in the latest test." dates={dates} latestLegend series={competitorSeries} />
 <div class="ai-ranking-heading"><h2>Competitor ranking</h2><p>Who appears in the latest AI answers, by engine. Arrows show rank changes since 12 October.</p></div>
 <div class="ai-competitor-filters" role="group" aria-label="Competitor engine filter"><button type="button" data-ai-competitor-engine="all" aria-pressed="true">All engines</button>{engines.map(engine=><button type="button" data-ai-competitor-engine={engine.id} aria-pressed="false" aria-label={engine.label} title={engine.label}><img class="ai-engine-logo" src={engine.icon} alt="" width="24" height="24" /></button>)}</div>
 <div class="ai-ranking-wrap"><table class="ai-ranking-table"><thead><tr><th scope="col">Rank</th><th scope="col">Brand</th><th scope="col">Visibility</th><th scope="col">Mentions</th></tr></thead><tbody>{ranking.map(brand=><tr data-ai-brand data-ai-brand-counts={JSON.stringify(brand.counts)} data-ai-brand-previous-ranks={JSON.stringify(previousRanks(brand.name))} class={brand.own?'ai-own-brand':''}><td><span data-ai-brand-rank>{rankPosition(scoreFor(brand.counts,-1),ranking.map(item=>scoreFor(item.counts,-1))) ?? "—"}</span><span data-ai-brand-movement class={`ai-rank-movement ${initialMovement(brand.name,brand.counts).direction}`} title={initialMovement(brand.name,brand.counts).label} aria-label={initialMovement(brand.name,brand.counts).label}>{initialMovement(brand.name,brand.counts).text}</span></td><th scope="row">{brand.own&&<img src="/images/wheeler/logo.webp" alt="" />}<span>{brand.name}{brand.own&&<small>WHEELER</small>}</span></th><td data-ai-brand-visibility>{percentage(brand.counts.reduce((a,b)=>a+b,0),latest.answerCount)}%</td><td data-ai-brand-mentions>{brand.counts.reduce((a,b)=>a+b,0)}</td></tr>)}</tbody></table></div>
 <p class="ai-chart-method">Visibility is the share of tested answers mentioning a name. Each name counts once per answer; several names can appear together. Names are shown as recorded.</p>
 </section>
 <footer class="ai-monitoring-footer">Results reflect the saved answers in these tests. A mention is not a lead, a quotation or a guaranteed future recommendation.</footer>
 <script is:inline type="application/json" id="ai-monitoring-data" set:html={JSON.stringify(visibility.latestPrompts.map(prompt=>({...prompt,results:Object.fromEntries(engines.map(engine=>[engine.id,{...prompt.results[engine.id],renderedAnswer:formatRecordedAnswer(prompt.results[engine.id].answer)}]))}))).replace(/</g,String.fromCharCode(92)+'u003c')}></script>
</div>
<script>
 import '../../lib/clients/wheeler-ai-monitoring';
</script>
