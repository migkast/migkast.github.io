---
import { percentage } from '../../lib/clients/wheeler-visibility';
interface Props { id:string; title:string; description:string; dates:string[]; latestLegend?:boolean; series:{key:string;label:string;icon?:string;own?:boolean;color:string;counts:number[];total:number}[] }
const {id,title,description,dates,series,latestLegend=false}=Astro.props;

---
<section id={id} class="visibility-chart" aria-labelledby={`${id}-title`}>
 <h2 id={`${id}-title`}>{title}</h2><p>{description}</p>
 <div class="visibility-plot"><canvas data-visibility-canvas role="img" aria-label={`${title}. Exact scores are listed in the legend below.`}></canvas></div>
 <script is:inline type="application/json" data-visibility-data set:html={JSON.stringify({dates,series}).replace(/</g,String.fromCharCode(92)+'u003c')}></script>
 <div class="visibility-chart-legend" aria-label={`${title} series`}>{latestLegend&&<button type="button" class="ai-chart-all" data-chart-all aria-pressed="true">All companies</button>}{series.map(item=><button type="button" class={item.own?'ai-chart-own':undefined} data-chart-toggle={item.key} aria-pressed="true"><span class="visibility-swatch" style={`background:${item.color}`} aria-hidden="true"></span><span><strong>{item.icon&&<img class="ai-engine-logo" src={item.icon} alt="" width="20" height="20" />}{item.label}{item.own&&<span class="ai-your-brand">YOUR BRAND</span>}</strong><small>{latestLegend?<>{percentage(item.counts[item.counts.length-1],item.total)}% <span>({item.counts[item.counts.length-1]} of {item.total})</span></>:<>{percentage(item.counts[0],item.total)}% → {percentage(item.counts[1],item.total)}%</>}</small></span></button>)}</div>
</section>
<script>
 import '../../lib/clients/wheeler-visibility-chart';
</script>
