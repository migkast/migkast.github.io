---
import { copy, routeFor, sectionLabels, type Language } from '../lib/site';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const labels = sectionLabels[lang];
---
<footer class="footer">
  <div>
    <a class="brand footer-brand" href={routeFor(lang)}><span class="brand-mark">MC</span><span>Miguel Casteleiro</span></a>
    <p>{t.footer}</p>
  </div>
  <div class="footer-links">
    {lang === 'en' ? <a href="/blog/">Blog</a> : null}
    <a href="https://www.linkedin.com/in/mcasteleiro/" rel="me">LinkedIn</a>
    <a href="https://www.seoforgpt.io/agencies">{labels.seoLink}</a>
    <a href={routeFor(lang, 'contact')}>{t.cta}</a>
  </div>
  <p class="fine-print">© {new Date().getFullYear()} Miguel Casteleiro</p>
</footer>
