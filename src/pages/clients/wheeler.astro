---
import '../../styles/wheeler-workspace.css';
import ClusterDetail from '../../components/clients/ClusterDetail.astro';
import BacklinkAudit from '../../components/clients/BacklinkAudit.astro';
import PublicationCalendar from '../../components/clients/PublicationCalendar.astro';
import { workspace } from '../../lib/clients/wheeler';
const reviewApi = import.meta.env.PUBLIC_WHEELER_REVIEW_API || 'https://miguel-blog-webhook.hey-948.workers.dev/clients/wheeler';
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><meta name="description" content="Wheeler project workspace: content strategy, topic clusters and review." /><title>Wheeler · Content strategy workspace</title><link rel="icon" href="/favicon.svg" /></head>
<body class="wheeler-workspace">
  <section class="workspace-gate" id="workspace-gate" aria-labelledby="gate-heading"><img src="/images/wheeler/logo.webp" width="230" height="54" alt="Wheeler Residential Steel Supply" /><p class="eyebrow">Miguel × Wheeler</p><h1 id="gate-heading">A place to move<br />the work forward.</h1><p>Review the strategy. Share your input.<br />Decide what we create next.</p><form id="workspace-unlock"><div><label for="workspace-reviewer">Your name</label><input id="workspace-reviewer" value="Stacie Morris" maxlength="100" required autocomplete="name" /></div><label for="workspace-password">Workspace password</label><input id="workspace-password" type="password" required autocomplete="current-password" aria-describedby="password-error" /><button class="primary" type="submit">Open workspace ↗</button><p id="password-error" role="alert"></p></form><noscript>Enable JavaScript to open this workspace.</noscript></section>
  <div id="workspace-content" data-review-api={reviewApi} hidden>
    <a class="skip-link" href="#workspace-main">Skip to workspace</a>
    <aside class="workspace-sidebar"><a href="/clients/wheeler/" class="workspace-brand" aria-label="Wheeler workspace"><img src="/images/wheeler/logo.webp" width="184" height="44" alt="Wheeler Residential Steel Supply" /></a><p class="sidebar-caption">PROJECT WORKSPACE</p><nav aria-label="Project navigation"><p class="sidebar-group-title">SEO &amp; GEO</p><a class="sidebar-link active" href="#content" data-workspace-section="content" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" /></svg>Content</a><a class="sidebar-link" href="#backlinks" data-workspace-section="backlinks"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 13 4-4M8 16l-2 2a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0M16 8l2-2a4 4 0 0 1 6 6l-5 5a4 4 0 0 1-6 0" transform="translate(1 0) scale(.9)" /></svg>Backlinks</a></nav><div class="sidebar-bottom"><div class="workspace-author"><img src="/images/miguel-headshot.jpg" width="40" height="40" alt="" /><span>Miguel Casteleiro<small>Your growth partner</small></span></div><button type="button" id="workspace-lock">Lock workspace</button></div></aside>
    <div class="workspace-body">
      <header class="workspace-topbar"><span>Wheeler <span aria-hidden="true">/</span> <span id="workspace-section-label">Content</span></span><span>Prepared for Stacie Morris</span></header>
      <main id="workspace-main" tabindex="-1">
        <div id="workspace-section-content">
        <header class="workspace-heading"><div><h1>Wheeler content strategy</h1></div><div class="review-overview"><strong id="review-progress">0 of {workspace.clusters.length} reviewed</strong><div class="progress-track" aria-hidden="true"><span id="progress-fill"></span></div><small>Updated {workspace.updated}</small></div></header>
        <div class="workspace-tabs" role="tablist" aria-label="Content strategy views"><button id="view-clusters" role="tab" aria-selected="true" aria-controls="panel-clusters" tabindex="0">Topic clusters</button><button id="view-plan" role="tab" aria-selected="false" aria-controls="panel-plan" tabindex="-1">Publication calendar</button></div>
        <div id="shared-sync-error" class="shared-sync-error" hidden><p id="save-status" role="status"></p><button id="retry-shared-review" type="button" hidden>Retry saving</button></div>
        <section id="panel-clusters" role="tabpanel" aria-labelledby="view-clusters">
          <div class="review-intro"><p><strong>Topic clusters</strong> group related articles around one buyer decision.</p></div>

          <div class="cluster-workbench"><nav class="cluster-navigation" aria-label="Choose a topic cluster"><p class="eyebrow">PROPOSED DIRECTIONS</p>{workspace.clusters.map((cluster,index) => <button type="button" class:list={['cluster-select',{ selected: index === 0 }]} data-select-cluster={cluster.key} aria-pressed={index === 0} aria-controls={`cluster-${cluster.key}`}><span class="cluster-index">0{index+1}</span><span class="cluster-selection-copy"><strong>{cluster.shortName}</strong><small>{cluster.onHold ? 'On hold · no planned articles' : 'Proposed direction'}</small><span class="cluster-status" data-status-for={cluster.key}>Awaiting review</span></span><span class="cluster-arrow" aria-hidden="true">↗</span></button>)}</nav><div class="cluster-details">{workspace.clusters.map((cluster,index) => <ClusterDetail cluster={cluster} index={index} />)}</div></div>
          <section class="cluster-ideas" aria-labelledby="ideas-heading">
            <div class="ideas-heading"><div><h2 id="ideas-heading">Suggested cluster ideas</h2><p>Is there an audience, question or opportunity we should add?</p></div><div class="ideas-heading-actions"><span id="idea-count">0 suggestions</span><button class="suggest-cluster" type="button" data-open-ideas aria-expanded="false" aria-controls="cluster-ideas-form">＋ Suggest a new cluster</button></div></div>
            <form id="cluster-ideas-form" hidden><div><label for="idea-title">Cluster idea</label><input id="idea-title" maxlength="150" placeholder="e.g. Framing decisions for ADU projects" required aria-describedby="idea-error" /></div><div><label for="idea-description">What should it cover? <span>Optional</span></label><textarea id="idea-description" rows="3" maxlength="1500" placeholder="Add the audience, questions or business opportunity you have in mind…"></textarea></div><p id="idea-error" class="field-error" role="alert"></p><div class="idea-form-actions"><button type="submit" id="save-idea">Save cluster idea</button><button type="button" class="text-button" id="cancel-idea">Cancel</button></div><p class="helper">Ideas are saved automatically and visible to both Stacie and Miguel.</p></form>
            <ul id="cluster-idea-list" aria-label="Suggested clusters" hidden></ul>
            <p id="idea-save-status" role="status"></p><button type="button" class="text-button" id="undo-idea-removal" hidden>Undo removal</button>
          </section>
        </section>
        <section id="panel-plan" role="tabpanel" aria-labelledby="view-plan" hidden><div class="panel-heading"><h2>The publication plan comes next.</h2><p>Let’s review the clusters first. Once the directions are agreed, we’ll develop the articles and publishing sequence.</p></div><PublicationCalendar /></section>

        </div>
        <section id="workspace-section-backlinks" aria-label="Backlinks" hidden><BacklinkAudit /></section>
      </main>
      <footer class="workspace-footer"><span>Wheeler × Miguel Casteleiro</span><a href="mailto:hey@seoforgpt.io">Questions? Email Miguel ↗</a></footer>
    </div>
  </div>
</body>
</html>
<script>
  import '../../lib/clients/wheeler-workspace';
</script>
