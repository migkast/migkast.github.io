---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout lang="en" title="Page not found" path="404.html" noindex>
  <Header lang="en" />
  <main id="main"><section class="section page-hero"><p class="eyebrow">404</p><h1>This page is not part of the system.</h1><p class="lead">Return to the growth advisory website.</p><a class="button" href="/en/">Go to homepage</a></section></main>
  <Footer lang="en" />
</BaseLayout>
