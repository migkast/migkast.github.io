---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookingForm from '../../components/BookingForm.astro';
import FaqSection from '../../components/FaqSection.astro';
import { copy, languages, langFrom } from '../../lib/site';
import { faqs } from '../../lib/faqs';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = langFrom(Astro.params.lang); const t = copy[lang];
---
<BaseLayout lang={lang} title={t.formTitle} path="contact/">
  <Header lang={lang} active="contact" />
  <main id="main">
    <section class="section page-hero">
      <p class="eyebrow">{t.cta}</p>
      <h1>{t.formTitle}</h1>
      <p class="lead">{t.formIntro}</p>
      <BookingForm lang={lang} />
    </section>
    <FaqSection lang={lang} items={faqs[lang].contact} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
