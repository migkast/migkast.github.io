---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GrowthSystem from '../../components/GrowthSystem.astro';
import FaqSection from '../../components/FaqSection.astro';
import { clients, copy, type Language } from '../../lib/site';
import { faqs, type FaqPage } from '../../lib/faqs';

const pages = {
  en: {
    approach: ['Approach', 'A growth system is only useful when it improves the decisions made every week.', [['Why channel optimization is not enough', 'A company can have good people in every channel and still stall. Growth breaks when commercial targets, measurement, acquisition, conversion, retention and execution point in different directions.'], ['Start with commercial truth', 'We establish contribution margin, customer acquisition boundaries, payback expectations and the numbers leadership should actually use. Without those boundaries, every channel can look successful while the business becomes less profitable.'], ['Find the real constraint', 'I separate symptoms from causes. The constraint may be the agency, internal capability, measurement, creative supply, conversion, retention or the strategy connecting them.'], ['Direct the people already doing the work', 'I do not automatically replace agencies or internal specialists. I clarify what each person owns, what good performance means and which decisions need to be escalated.'], ['Create a useful operating rhythm', 'Priorities become a working plan with owners, deadlines, review meetings and clear rules for changing budgets or direction.'], ['What I do not do', 'I do not become another pair of hands inside every advertising account. Existing specialists keep executing. My responsibility is to make sure they are solving the right problem against the right target.']]],
    experience: ['Experience', 'Seven years leading growth across agencies, brands, teams and technical products.', [['Seven years. 130 brands.', 'I led growth inside a performance marketing agency across fashion, beauty, home, marketplaces, SaaS and other industries. My preferred work now is with ambitious e-commerce companies between $2M and $20M.'], ['€5M to €10M in annual media spend', 'As Head of Growth, I directed strategy and marketing operations across more than 30 concurrent brands while managing significant annual acquisition budgets.'], ['Full-funnel responsibility', 'The work covered paid acquisition, P&L, lifecycle marketing, retention, landing pages, conversion, offers and multi-channel strategy across B2C and B2B companies.'], ['Built teams and operating capability', 'I helped grow the agency from startup to an established operation and hired across marketing, development, data analytics and operations. I also founded its MarvelLabs research and development division.'], ['Built attribution infrastructure', 'As CTO of MarvelPixel, I led the development of a first-party attribution platform combining server-side tracking, data modelling and multi-touch attribution.'], ['Built for the next discovery shift', 'I built SEOforGPT around the real workflows agencies need for AI visibility audits, competitor monitoring, citation analysis, content and multi-client reporting.'], ['Why I work with five companies', 'I now work directly with no more than five companies so I can stay close to the commercial decisions, teams, agencies and numbers.']]],
    insights: ['Insights', 'Practical questions for founders who want more control over growth.', [['Why is growth a management system?', 'Why channel performance cannot be separated from economics, measurement, conversion, retention and team accountability.'], ['How to evaluate a marketing agency', 'The questions that reveal whether an agency understands the commercial target, has a coherent plan and knows which decisions it owns.'], ['When Meta is ready to scale', 'How economics, creative supply, conversion and measurement determine whether the account can absorb more budget.'], ['How to set useful growth targets', 'A practical way to connect CAC, CPO, LTV, MER, ROAS, contribution margin and payback without creating a dashboard nobody uses.'], ['How to find the real growth constraint', 'Why more spend, a new agency or another channel may solve the wrong problem, and what to examine first.'], ['How AI visibility changes discovery', 'What e-commerce leaders should understand about recommendations, citations and brand visibility across AI search and answer engines.']]],
    about: ['About Miguel', 'I combine growth leadership, technical product building and an engineering approach to difficult commercial problems.', [['I did not start in advertising', 'My background is in bioengineering, nanosystems and applied microfluidics. I worked on organ-on-a-chip systems and microfluidic devices for cancer and cardiovascular research. That training shaped how I approach growth: understand the system, isolate the constraint and test against evidence.'], ['I became an e-commerce operator', 'I built and operated e-commerce businesses myself. I set up Shopify stores, managed Meta and Google campaigns, controlled budgets, wrote creative briefs, tested landing pages and offers, built email automations, planned promotions, read performance reports and worked on conversion every day. I know what execution actually requires.'], ['Seven years leading Marvel Test', 'I founded Marvel Test and spent seven years as Head of Growth and Innovation, responsible for client strategy and the performance marketing team. I led the work across 130 brands and managed €5M to €10M in annual media spend.'], ['I built the technology too', 'I founded MarvelLabs and served as CTO of MarvelPixel, building first-party attribution infrastructure with server-side tracking, data modelling and multi-touch attribution. I later built SEOforGPT, an AI visibility platform designed around the needs of agencies.'], ['Education across engineering and management', 'My education includes bioengineering and nanosystems at Instituto Superior Técnico, management at Nova School of Business and Economics, applied microfluidics research at the University of Twente and hands-on growth training at Growth Tribe.'], ['How I work', 'I value commercial clarity, technical depth, direct communication and clear ownership. I will challenge an agency when the agency is the problem, but I will not recommend replacing people when the real constraint sits elsewhere.'], ['The work now', 'I work directly with a maximum of five established e-commerce companies through a three-month advisory or as Fractional Head of Growth.']]]
  },
  pt: {
    abordagem: ['Abordagem', 'Um sistema de crescimento só é útil quando melhora as decisões tomadas todas as semanas.', [['Porque otimizar canais não chega', 'Uma empresa pode ter bons especialistas em cada canal e continuar bloqueada. O crescimento falha quando objetivos comerciais, medição, aquisição, conversão, retenção e execução apontam em direções diferentes.'], ['Começar pela verdade comercial', 'Definimos margem de contribuição, limites de aquisição, expectativas de payback e os números que a liderança deve realmente usar. Sem esses limites, todos os canais podem parecer bem enquanto o negócio perde rentabilidade.'], ['Encontrar o verdadeiro bloqueio', 'Separo sintomas de causas. O bloqueio pode estar na agência, na capacidade interna, na medição, na criatividade, na conversão, na retenção ou na estratégia que liga tudo.'], ['Dirigir as pessoas que já executam', 'Não substituo automaticamente agências ou especialistas internos. Clarifico o que cada pessoa controla, o que significa bom desempenho e quais decisões devem ser escaladas.'], ['Criar um ritmo operacional útil', 'As prioridades tornam-se num plano com responsáveis, prazos, reuniões de revisão e regras claras para alterar orçamento ou direção.'], ['O que não faço', 'Não me torno mais um par de mãos dentro de cada conta de publicidade. Os especialistas continuam a executar. A minha responsabilidade é garantir que resolvem o problema certo com o objetivo certo.']]],
    experiencia: ['Experiência', 'Sete anos a liderar crescimento entre agências, marcas, equipas e produtos técnicos.', [['Sete anos. 130 marcas.', 'Liderei crescimento numa agência de performance marketing em moda, beleza, casa, marketplaces, SaaS e outras indústrias. Hoje prefiro trabalhar com empresas ambiciosas de e-commerce entre $2M e $20M.'], ['€5M a €10M de investimento anual em media', 'Como Head of Growth, dirigi estratégia e operações de marketing em mais de 30 marcas em simultâneo, gerindo orçamentos anuais significativos de aquisição.'], ['Responsabilidade full-funnel', 'O trabalho incluiu aquisição paga, P&L, lifecycle marketing, retenção, landing pages, conversão, ofertas e estratégia multicanal em empresas B2C e B2B.'], ['Construção de equipas e capacidade', 'Ajudei a transformar a agência de startup numa operação estabelecida e contratei em marketing, desenvolvimento, data analytics e operações. Também fundei a divisão de investigação MarvelLabs.'], ['Infraestrutura de atribuição', 'Como CTO da MarvelPixel, liderei o desenvolvimento de uma plataforma de atribuição first-party com server-side tracking, modelação de dados e atribuição multi-touch.'], ['Construído para a próxima mudança na descoberta', 'Criei a SEOforGPT com base nos workflows reais de que as agências precisam para auditorias de visibilidade em IA, monitorização de concorrentes, análise de citações, conteúdo e reporting multi-cliente.'], ['Porquê cinco empresas', 'Hoje trabalho diretamente com um máximo de cinco empresas para me manter próximo das decisões comerciais, equipas, agências e números.']]],
    insights: ['Insights', 'Questões práticas para fundadores que querem mais controlo sobre o crescimento.', [['Porque é que o crescimento é um sistema de gestão?', 'Porque a performance dos canais não pode ser separada da economia, medição, conversão, retenção e responsabilidade da equipa.'], ['Como avaliar uma agência de marketing', 'As perguntas que revelam se uma agência compreende o objetivo comercial, tem um plano coerente e sabe que decisões controla.'], ['Quando a Meta está pronta para escalar', 'Como economia, criatividade, conversão e medição determinam se a conta consegue absorver mais orçamento.'], ['Como definir objetivos de crescimento úteis', 'Uma forma prática de ligar CAC, CPO, LTV, MER, ROAS, margem de contribuição e payback sem criar um dashboard que ninguém usa.'], ['Como encontrar o verdadeiro bloqueio', 'Porque mais orçamento, uma nova agência ou outro canal podem resolver o problema errado, e o que analisar primeiro.'], ['Como a visibilidade em IA muda a descoberta', 'O que líderes de e-commerce devem saber sobre recomendações, citações e visibilidade de marca em motores de pesquisa e resposta de IA.']]],
    sobre: ['Sobre Miguel', 'Combino liderança de crescimento, construção de produtos técnicos e uma abordagem de engenharia a problemas comerciais difíceis.', [['Não comecei em publicidade', 'A minha formação é em bioengenharia, nanossistemas e microfluídica aplicada. Trabalhei em sistemas organ-on-a-chip e dispositivos para investigação oncológica e cardiovascular. Essa formação moldou a minha abordagem: compreender o sistema, isolar o bloqueio e testar com evidência.'], ['Tornei-me operador de e-commerce', 'Construí e operei negócios de e-commerce. Configurei lojas Shopify, geri campanhas de Meta e Google, controlei orçamentos, escrevi briefings criativos, testei landing pages e ofertas, criei automações de email, planeei promoções, analisei performance e trabalhei diariamente na conversão. Sei o que a execução exige.'], ['Sete anos a liderar a Marvel Test', 'Fundei a Marvel Test e passei sete anos como Head of Growth and Innovation, responsável pela estratégia dos clientes e pela equipa de performance marketing. Liderei o trabalho em 130 marcas e geri €5M a €10M de investimento anual em media.'], ['Também construí a tecnologia', 'Fundei a MarvelLabs e fui CTO da MarvelPixel, construindo infraestrutura de atribuição first-party com server-side tracking, modelação de dados e atribuição multi-touch. Mais tarde criei a SEOforGPT, uma plataforma de visibilidade em IA pensada para as necessidades das agências.'], ['Formação entre engenharia e gestão', 'A minha formação inclui bioengenharia e nanossistemas no Instituto Superior Técnico, gestão na Nova School of Business and Economics, investigação em microfluídica aplicada na University of Twente e formação prática em crescimento na Growth Tribe.'], ['Como trabalho', 'Valorizo clareza comercial, profundidade técnica, comunicação direta e responsabilidade clara. Desafio uma agência quando a agência é o problema, mas não recomendo trocar pessoas quando o verdadeiro bloqueio está noutro lugar.'], ['O trabalho atual', 'Trabalho diretamente com um máximo de cinco empresas de e-commerce através de advisory de três meses ou como Head of Growth Fracional.']]]
  },
  es: {
    enfoque: ['Enfoque', 'Un sistema de crecimiento solo es útil cuando mejora las decisiones tomadas cada semana.', [['Por qué optimizar canales no es suficiente', 'Una empresa puede tener buenos especialistas en cada canal y seguir bloqueada. El crecimiento falla cuando objetivos comerciales, medición, adquisición, conversión, retención y ejecución apuntan en direcciones diferentes.'], ['Empezar por la verdad comercial', 'Definimos margen de contribución, límites de adquisición, expectativas de payback y los números que la dirección debe utilizar. Sin esos límites, todos los canales pueden parecer exitosos mientras el negocio pierde rentabilidad.'], ['Encontrar el verdadero obstáculo', 'Separo los síntomas de las causas. El obstáculo puede estar en la agencia, la capacidad interna, la medición, la creatividad, la conversión, la retención o la estrategia que conecta todo.'], ['Dirigir a las personas que ya ejecutan', 'No sustituyo automáticamente agencias o especialistas internos. Aclaro qué controla cada persona, qué significa un buen rendimiento y qué decisiones deben escalarse.'], ['Crear un ritmo operativo útil', 'Las prioridades se convierten en un plan con responsables, plazos, reuniones de revisión y reglas claras para cambiar presupuesto o dirección.'], ['Lo que no hago', 'No me convierto en otro operador dentro de cada cuenta publicitaria. Los especialistas siguen ejecutando. Mi responsabilidad es asegurar que resuelven el problema correcto con el objetivo correcto.']]],
    experiencia: ['Experiencia', 'Siete años liderando crecimiento entre agencias, marcas, equipos y productos técnicos.', [['Siete años. 130 marcas.', 'Lideré crecimiento en una agencia de performance marketing en moda, belleza, hogar, marketplaces, SaaS y otras industrias. Ahora prefiero trabajar con empresas ambiciosas de e-commerce de $2M a $20M.'], ['€5M a €10M de inversión anual en medios', 'Como Head of Growth, dirigí estrategia y operaciones de marketing en más de 30 marcas simultáneamente, gestionando presupuestos anuales significativos de adquisición.'], ['Responsabilidad full-funnel', 'El trabajo incluyó adquisición de pago, P&L, lifecycle marketing, retención, landing pages, conversión, ofertas y estrategia multicanal en empresas B2C y B2B.'], ['Construcción de equipos y capacidad', 'Ayudé a convertir la agencia de startup en una operación establecida y contraté en marketing, desarrollo, data analytics y operaciones. También fundé la división de investigación MarvelLabs.'], ['Infraestructura de atribución', 'Como CTO de MarvelPixel, lideré el desarrollo de una plataforma de atribución first-party con server-side tracking, modelado de datos y atribución multi-touch.'], ['Creado para el próximo cambio en descubrimiento', 'Creé SEOforGPT a partir de los workflows reales que las agencias necesitan para auditorías de visibilidad en IA, seguimiento de competidores, análisis de citas, contenido y reporting multicliente.'], ['Por qué cinco empresas', 'Ahora trabajo directamente con un máximo de cinco empresas para mantenerme cerca de las decisiones comerciales, los equipos, las agencias y los números.']]],
    ideas: ['Ideas', 'Preguntas prácticas para fundadores que quieren más control sobre el crecimiento.', [['¿Por qué el crecimiento es un sistema de gestión?', 'Por qué el rendimiento de los canales no puede separarse de la economía, medición, conversión, retención y responsabilidad del equipo.'], ['Cómo evaluar una agencia de marketing', 'Las preguntas que revelan si una agencia entiende el objetivo comercial, tiene un plan coherente y sabe qué decisiones controla.'], ['Cuándo Meta está lista para escalar', 'Cómo economía, creatividad, conversión y medición determinan si la cuenta puede absorber más presupuesto.'], ['Cómo definir objetivos de crecimiento útiles', 'Una forma práctica de conectar CAC, CPO, LTV, MER, ROAS, margen de contribución y payback sin crear un dashboard que nadie utiliza.'], ['Cómo encontrar el verdadero obstáculo', 'Por qué más presupuesto, una nueva agencia u otro canal pueden resolver el problema equivocado, y qué examinar primero.'], ['Cómo la visibilidad en IA cambia el descubrimiento', 'Lo que los líderes de e-commerce deben saber sobre recomendaciones, citas y visibilidad de marca en motores de búsqueda y respuesta de IA.']]],
    'sobre-mi': ['Sobre Miguel', 'Combino liderazgo de crecimiento, construcción de productos técnicos y un enfoque de ingeniería para problemas comerciales difíciles.', [['No empecé en publicidad', 'Mi formación es en bioingeniería, nanosistemas y microfluídica aplicada. Trabajé en sistemas organ-on-a-chip y dispositivos para investigación oncológica y cardiovascular. Esa formación definió mi enfoque: entender el sistema, aislar el obstáculo y probar con evidencia.'], ['Me convertí en operador de e-commerce', 'Construí y operé negocios de e-commerce. Configuré tiendas Shopify, gestioné campañas de Meta y Google, controlé presupuestos, redacté briefings creativos, probé landing pages y ofertas, creé automatizaciones de email, planifiqué promociones, analicé performance y trabajé diariamente en conversión. Sé lo que exige la ejecución.'], ['Siete años liderando Marvel Test', 'Fundé Marvel Test y pasé siete años como Head of Growth and Innovation, responsable de la estrategia de clientes y del equipo de performance marketing. Lideré el trabajo en 130 marcas y gestioné entre €5M y €10M de inversión anual en medios.'], ['También construí la tecnología', 'Fundé MarvelLabs y fui CTO de MarvelPixel, construyendo infraestructura de atribución first-party con server-side tracking, modelado de datos y atribución multi-touch. Más tarde creé SEOforGPT, una plataforma de visibilidad en IA diseñada para las necesidades de las agencias.'], ['Formación entre ingeniería y gestión', 'Mi formación incluye bioingeniería y nanosistemas en el Instituto Superior Técnico, gestión en Nova School of Business and Economics, investigación en microfluídica aplicada en la University of Twente y formación práctica de crecimiento en Growth Tribe.'], ['Cómo trabajo', 'Valoro la claridad comercial, la profundidad técnica, la comunicación directa y la responsabilidad clara. Cuestiono a una agencia cuando la agencia es el problema, pero no recomiendo sustituir personas cuando el verdadero obstáculo está en otro lugar.'], ['El trabajo actual', 'Trabajo directamente con un máximo de cinco empresas de e-commerce mediante asesoría de tres meses o como Head of Growth Fraccional.']]]
  }
} as const;

export function getStaticPaths() {
  return [
    ['en', 'approach'], ['en', 'experience'], ['en', 'insights'], ['en', 'about'],
    ['pt', 'abordagem'], ['pt', 'experiencia'], ['pt', 'insights'], ['pt', 'sobre'],
    ['es', 'enfoque'], ['es', 'experiencia'], ['es', 'ideas'], ['es', 'sobre-mi']
  ].map(([lang, slug]) => ({ params: { lang, slug } }));
}
const lang = Astro.params.lang as Language;
const slug = Astro.params.slug as keyof (typeof pages)[typeof lang];
const page = pages[lang][slug] as readonly [string, string, readonly (readonly [string, string])[]];
const t = copy[lang];
const isApproach = ['approach', 'abordagem', 'enfoque'].includes(slug);
const isExperience = ['experience', 'experiencia'].includes(slug);
const isInsights = ['insights', 'ideas'].includes(slug);
const isAbout = ['about', 'sobre', 'sobre-mi'].includes(slug);
const faqPage: FaqPage = isApproach ? 'approach' : isExperience ? 'experience' : isInsights ? 'insights' : 'about';
const pageLabels = {
  en: { experience: 'Selected operating experience', thinking: 'Questions worth answering', background: 'Background and operating principles', links: 'Selected links' },
  pt: { experience: 'Experiência operacional selecionada', thinking: 'Questões que vale a pena responder', background: 'Percurso e princípios de trabalho', links: 'Links selecionados' },
  es: { experience: 'Experiencia operativa seleccionada', thinking: 'Preguntas que merece la pena responder', background: 'Trayectoria y principios de trabajo', links: 'Enlaces seleccionados' }
}[lang];
---
<BaseLayout lang={lang} title={page[0]} description={page[1]} path={`${slug}/`}>
  <Header lang={lang} active={slug} />
  <main id="main">
    <section class={`section page-hero supporting-hero ${isAbout ? 'supporting-hero-about' : ''}`}>
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{page[0]}</h1>
      </div>
      <div class="supporting-hero-intro">
        {isAbout ? <figure class="about-portrait"><img src="/images/miguel-headshot.jpg" alt="Miguel Casteleiro" width="800" height="800" /></figure> : null}
        <p class="lead">{page[1]}</p>
      </div>
    </section>

    <section class={`section supporting-content ${isInsights ? 'insight-grid' : 'supporting-rows'}`}>
      <p class="eyebrow">{isInsights ? pageLabels.thinking : isAbout ? pageLabels.background : 'Miguel Casteleiro'}</p>
      <div class="supporting-items">
        {page[2].map(([title, body], index) => <article class="supporting-item" data-reveal>
          <span>0{index + 1}</span>
          <h2>{title}</h2>
          <p>{body}</p>
        </article>)}
      </div>
    </section>

    {isApproach ? <section class="section supporting-system"><GrowthSystem lang={lang} /></section> : null}

    {isExperience ? <section class="section experience-proof">
      <p class="eyebrow">{pageLabels.experience}</p>
      <ul class="stats supporting-stats">{t.stats.map(([number, label], index) => <li><small>0{index + 1}</small><strong>{number}</strong><span>{label}</span></li>)}</ul>
    </section> : null}

    {isExperience ? <section class="section experience-brands">
      <p class="eyebrow">{t.logoTitle}</p>
      <div class="logo-cloud">
        {clients.map((client) => <a class={`brand-logo ${client.size || ''} tone-${client.tone || 'natural'}`} href={client.website} aria-label={`${client.name} website`}>
          {client.asset ? <img src={client.asset} alt={`${client.name} logo`} loading="lazy" /> : <span>{client.name}</span>}
        </a>)}
      </div>
    </section> : null}

    {isAbout ? <section class="section about-links">
      <p class="eyebrow">{pageLabels.links}</p>
      <div>
        <a class="text-link" href="https://www.linkedin.com/in/mcasteleiro/">LinkedIn ↗</a>
        <a class="text-link" href="https://www.seoforgpt.io/">SEOforGPT ↗</a>
      </div>
    </section> : null}

    <FaqSection lang={lang} items={faqs[lang][faqPage]} />

    <section class="section section-signal supporting-cta">
      <h2>{t.finalTitle}</h2>
      <p>{t.finalBody}</p>
      <a class="button" href={`/${lang}/contact/`}>{t.cta}</a>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
